diff --git a/include/linux/cgroup_subsys.h b/include/linux/cgroup_subsys.h
index 445235487..b15cdcad5 100644
--- a/include/linux/cgroup_subsys.h
+++ b/include/linux/cgroup_subsys.h
@@ -45,7 +45,17 @@ SUBSYS(net_cls)
 SUBSYS(perf_event)
 #endif
 
-#if IS_ENABLED(CONFIG_CGROUP_NET_PRIO)
+/*
+ * Droidspaces pids slot swap (GKI kABI): with CONFIG_CGROUP_NET_PRIO=n and
+ * CONFIG_CGROUP_PIDS=y, pids takes net_prio's id, so the subsystem count
+ * and every other id stay the same and no struct layout moves. Only while
+ * genksyms reads enum cgroup_subsys_id (CGROUP_SUBSYS_ID_ENUM, set in
+ * cgroup-defs.h) the id keeps its stock name net_prio_cgrp_id, so the CRCs
+ * of everything built on that enum match the stock GKI kernel. Same value,
+ * same size - nothing is added to or hidden from any struct.
+ */
+#if IS_ENABLED(CONFIG_CGROUP_NET_PRIO) || \
+	(defined(__GENKSYMS__) && defined(CGROUP_SUBSYS_ID_ENUM) && IS_ENABLED(CONFIG_CGROUP_PIDS))
 SUBSYS(net_prio)
 #endif
 
@@ -53,7 +63,8 @@ SUBSYS(net_prio)
 SUBSYS(hugetlb)
 #endif
 
-#if IS_ENABLED(CONFIG_CGROUP_PIDS)
+#if IS_ENABLED(CONFIG_CGROUP_PIDS) && \
+	!(defined(__GENKSYMS__) && defined(CGROUP_SUBSYS_ID_ENUM) && !IS_ENABLED(CONFIG_CGROUP_NET_PRIO))
 SUBSYS(pids)
 #endif
 
